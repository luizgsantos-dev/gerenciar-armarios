# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...menos o modelo, que precisa estar no repositório
!.env.example

# vercel
.vercel

# configuração local de ferramentas de desenvolvimento
# (contém caminhos da máquina)
/.claude/

# instruções para assistentes de IA, regeradas pelo `next dev` a cada
# execução — ficam no disco, mas não no repositório
/AGENTS.md
/CLAUDE.md

# banco de dados local e uploads (contêm dados pessoais/comprovantes)
/prisma/*.db
/prisma/*.db-journal
/uploads/

# typescript
*.tsbuildinfo
next-env.d.ts
