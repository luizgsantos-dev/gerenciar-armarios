# Caminho do banco SQLite.
# Local: relativo à pasta prisma/. No container usamos um caminho absoluto
# em volume (ver docker-compose.yml).
DATABASE_URL="file:./dev.db"

# Segredo usado para assinar o cookie de sessão do admin.
# Gere um valor forte: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="troque-este-valor-por-uma-string-aleatoria-longa"

# Primeiro usuário admin. É criado automaticamente se ainda não existir.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="troque-esta-senha"

# Defina como true para redefinir a senha do admin acima na próxima
# inicialização. Fora isso, a senha existente é sempre preservada.
ADMIN_FORCE_PASSWORD_RESET="false"

# Cria armários de exemplo (A-01, A-02, ...) quando o banco ainda está vazio.
# Útil para testar; desligue em produção e cadastre os armários pelo painel.
SEED_EXAMPLE_LOCKERS="false"
SEED_LOCKER_COUNT="20"
